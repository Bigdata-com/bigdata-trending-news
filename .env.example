# Copy to .env and fill in. Real environment variables take precedence over .env.

# Required for live runs (without it, the notebooks replay the saved run in fixtures/).
BIGDATA_API_KEY=

# LLM (optional). Anthropic Claude is the default provider.
ANTHROPIC_API_KEY=
# Or use OpenAI instead:
# OPENAI_API_KEY=
# LLM_PROVIDER=openai           # "anthropic" | "openai" (default: whichever key is set, Anthropic first)
# LLM_MODEL=claude-sonnet-5-5   # default per provider: claude-sonnet-5-5 / gpt-4.1

# Optional
# REPLAY=1                      # force offline replay from fixtures/
# AS_OF=2026-10-13T19:10:00Z    # pin the run's reference time (UTC)
# OUTPUTS_DIR=/some/folder      # where reports/CSVs go (default outputs/; the scheduled runner sets this per run)
