# Copy to .env and fill in. Real environment variables take precedence over .env.

# Required. Notebooks call Bigdata.com with this key.
BIGDATA_API_KEY=

# LLM (optional). The notebooks use OpenAI GPT 5.6.
OPENAI_API_KEY=
# LLM_MODEL=gpt-5.6

# Optional
# AS_OF=2026-10-13T19:10:00Z    # pin the run's reference time (UTC)
# OUTPUTS_DIR=/some/folder      # where reports/CSVs go (default outputs/; the scheduled runner sets this per run)
